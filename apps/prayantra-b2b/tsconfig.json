{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@b2b/api-client": [
        "../../packages/api-client/src"
      ],
      "@b2b/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@b2b/shared-types": [
        "../../packages/shared-types/src"
      ],
      "@b2b/shared-types/*": [
        "../../packages/shared-types/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "App.tsx",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "android",
    "ios",
    "build",
    "dist",
    ".expo",
    ".turbo",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "jest.setup.js"
  ]
}
